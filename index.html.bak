  <div class="modal-overlay" id="project-modal" role="dialog" aria-modal="true" aria-labelledby="modal-project-title" hidden>
    <div class="modal-dialog-box">
      <div class="modal-head">
        <span class="modal-type-tag" id="modal-category">Technical Details</span>
        <button type="button" class="modal-close-btn" id="modal-close" aria-label="Close project details dialog">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>

      <div class="modal-body-content">
        <h3 class="modal-title" id="modal-project-title">Project Title</h3>
        <p class="modal-description" id="modal-project-desc">Project architectural overview and goals.</p>

        <div class="modal-section-block">
          <h4 class="modal-block-heading">Key Features &amp; Implementation:</h4>
          <ul class="modal-bullets-list" id="modal-features-list">
            <!-- Dynamically populated by JavaScript -->
          </ul>
        </div>

        <div class="modal-section-block">
          <h4 class="modal-block-heading">Technologies Used:</h4>
          <div class="modal-tech-pills" id="modal-tech-stack">
            <!-- Dynamically populated by JavaScript -->
          </div>
        </div>

        <div class="modal-section-block" id="modal-source-block">
          <h4 class="modal-block-heading">Source Code Availability:</h4>
          <p class="modal-source-note" id="modal-source-note">Available in local project directory.</p>
        </div>
      </div>

      <div class="modal-foot-actions">
        <button type="button" class="btn btn-secondary btn-sm" id="modal-btn-dismiss">Close</button>
        <a href="#" class="btn btn-primary btn-sm" id="modal-btn-action" target="_blank" rel="noopener noreferrer">Open Project</a>
      </div>
    </div>
  </div>

