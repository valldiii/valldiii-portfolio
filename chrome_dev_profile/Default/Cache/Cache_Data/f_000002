/* ========================================================
   VALLDIII COFFEE SHOP — PREMIUM ARTISAN STYLESHEET
   Design System: Warm Espresso, Caramel Gold, Cream Latte
   ======================================================== */

:root {
  --bg-body: #100a07;
  --bg-surface: #18110c;
  --bg-card: #201712;
  --bg-card-hover: #291e17;
  --border-subtle: rgba(226, 161, 86, 0.16);
  --border-accent: rgba(226, 161, 86, 0.5);
  --accent-gold: #E2A156;
  --accent-gold-hover: #f0b26b;
  --accent-gold-dark: #b87b32;
  --text-white: #FAF3EC;
  --text-body: #D4C3B5;
  --text-muted: #9E8C7E;
  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 20px;
  --radius-full: 9999px;
  --shadow-sm: 0 4px 14px rgba(0, 0, 0, 0.35);
  --shadow-card: 0 10px 30px rgba(0, 0, 0, 0.45);
  --shadow-hover: 0 16px 36px rgba(0, 0, 0, 0.6), 0 0 20px rgba(226, 161, 86, 0.15);
  --transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  --header-height: 72px;
}

*, *::before, *::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  font-size: 16px;
}

body {
  font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
  background-color: var(--bg-body);
  color: var(--text-body);
  line-height: 1.65;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

img {
  max-width: 100%;
  display: block;
}

a {
  color: inherit;
  text-decoration: none;
  transition: var(--transition);
}

button {
  font-family: inherit;
  cursor: pointer;
  border: none;
  outline: none;
  background: none;
  transition: var(--transition);
}

.container {
  width: 90%;
  max-width: 1100px;
  margin: 0 auto;
}

section[id] {
  scroll-margin-top: calc(var(--header-height) + 16px);
}

/* ========================================================
   TYPOGRAPHY & UTILITIES
   ======================================================== */
.text-center {
  text-align: center;
}

.section-tag {
  display: inline-block;
  font-size: 0.76rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: var(--accent-gold);
  background: rgba(226, 161, 86, 0.12);
  border: 1px solid rgba(226, 161, 86, 0.25);
  padding: 0.3rem 0.85rem;
  border-radius: var(--radius-full);
  margin-bottom: 0.85rem;
  text-transform: uppercase;
}

.section-title {
  font-size: clamp(1.85rem, 3.5vw, 2.5rem);
  font-weight: 800;
  color: var(--text-white);
  line-height: 1.25;
  margin-bottom: 0.85rem;
}

.section-subtitle {
  font-size: 1rem;
  color: var(--text-muted);
  max-width: 620px;
  margin: 0 auto 2.5rem;
  line-height: 1.65;
}

.section-subtitle strong {
  color: var(--text-white);
}

/* ========================================================
   BUTTONS
   ======================================================== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
  font-size: 0.95rem;
  font-weight: 700;
  padding: 0.75rem 1.6rem;
  border-radius: var(--radius-sm);
  transition: var(--transition);
  cursor: pointer;
}

.btn-primary {
  background-color: var(--accent-gold);
  color: #120b07;
  border: 1px solid var(--accent-gold);
  box-shadow: 0 4px 16px rgba(226, 161, 86, 0.3);
}

.btn-primary:hover {
  background-color: var(--accent-gold-hover);
  border-color: var(--accent-gold-hover);
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(226, 161, 86, 0.45);
  color: #0b0704;
}

.btn-secondary {
  background-color: rgba(255, 255, 255, 0.05);
  color: var(--text-white);
  border: 1px solid var(--border-subtle);
}

.btn-secondary:hover {
  background-color: rgba(226, 161, 86, 0.12);
  border-color: var(--accent-gold);
  color: var(--accent-gold);
  transform: translateY(-2px);
}

.btn-sm {
  padding: 0.55rem 1.15rem;
  font-size: 0.85rem;
}

/* ========================================================
   1. HEADER & NAVBAR
   ======================================================== */
.header {
  position: sticky;
  top: 0;
  z-index: 100;
  height: var(--header-height);
  background-color: rgba(16, 10, 7, 0.92);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
}

.nav-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.brand {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 1.3rem;
  font-weight: 800;
  color: var(--text-white);
}

.brand-icon {
  font-size: 1.4rem;
}

.brand-accent {
  color: var(--accent-gold);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 1.5rem;
}

.nav-item {
  font-size: 0.92rem;
  font-weight: 600;
  color: var(--text-body);
  position: relative;
  padding: 0.35rem 0;
}

.nav-item:hover, .nav-item.active {
  color: var(--accent-gold);
}

.btn-order-nav {
  background-color: var(--accent-gold);
  color: #120b07 !important;
  font-weight: 700;
  font-size: 0.85rem;
  padding: 0.5rem 1.15rem;
  border-radius: var(--radius-sm);
  box-shadow: 0 4px 12px rgba(226, 161, 86, 0.25);
}

.btn-order-nav:hover {
  background-color: var(--accent-gold-hover);
  transform: translateY(-2px);
}

/* Hamburger Button */
.nav-toggle {
  display: none;
  background: transparent;
  border: 1px solid var(--border-subtle);
  padding: 0.5rem;
  border-radius: var(--radius-sm);
  cursor: pointer;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 5px;
  width: 42px;
  height: 38px;
}

.nav-toggle .bar {
  display: block;
  width: 22px;
  height: 2px;
  background-color: var(--accent-gold);
  border-radius: 2px;
  transition: var(--transition);
}

.nav-toggle.is-active .bar:nth-child(1) {
  transform: translateY(7px) rotate(45deg);
}
.nav-toggle.is-active .bar:nth-child(2) {
  opacity: 0;
}
.nav-toggle.is-active .bar:nth-child(3) {
  transform: translateY(-7px) rotate(-45deg);
}

/* ========================================================
   2. HERO SECTION
   ======================================================== */
.hero-section {
  position: relative;
  padding: 4.5rem 0 5.5rem;
  overflow: hidden;
  background: radial-gradient(circle at 75% 30%, rgba(226, 161, 86, 0.08) 0%, transparent 60%);
}

.hero-glow-backlight {
  position: absolute;
  top: -120px;
  left: -120px;
  width: 400px;
  height: 400px;
  background: radial-gradient(circle, rgba(226, 161, 86, 0.12) 0%, transparent 70%);
  filter: blur(80px);
  pointer-events: none;
}

.hero-container {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  align-items: center;
  gap: 3.5rem;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.74rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--accent-gold);
  background: rgba(226, 161, 86, 0.1);
  border: 1px solid rgba(226, 161, 86, 0.22);
  padding: 0.35rem 0.9rem;
  border-radius: var(--radius-full);
  margin-bottom: 1.25rem;
}

.badge-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background-color: var(--accent-gold);
  box-shadow: 0 0 8px var(--accent-gold);
}

.hero-title {
  font-size: clamp(2.2rem, 4.5vw, 3.4rem);
  font-weight: 800;
  color: var(--text-white);
  line-height: 1.18;
  margin-bottom: 1.25rem;
}

.text-gradient {
  background: linear-gradient(135deg, #F5EBE1 0%, #E2A156 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-desc {
  font-size: 1.05rem;
  color: var(--text-body);
  line-height: 1.7;
  margin-bottom: 2rem;
  max-width: 540px;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: 2.75rem;
}

.hero-stats-strip {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  padding-top: 1.75rem;
  border-top: 1px solid var(--border-subtle);
}

.stat-pill {
  display: flex;
  flex-direction: column;
}

.stat-pill strong {
  font-size: 1.35rem;
  font-weight: 800;
  color: var(--accent-gold);
  line-height: 1.2;
}

.stat-pill span {
  font-size: 0.76rem;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.stat-separator {
  width: 1px;
  height: 32px;
  background-color: var(--border-subtle);
}

/* Hero Visual Card */
.hero-visual {
  display: flex;
  justify-content: center;
}

.hero-image-card {
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-card);
  border: 1px solid var(--border-subtle);
  background: var(--bg-card);
  width: 100%;
  max-width: 440px;
}

.hero-img {
  width: 100%;
  aspect-ratio: 4/3;
  object-fit: cover;
  display: block;
  transition: transform 0.6s ease;
}

.hero-image-card:hover .hero-img {
  transform: scale(1.04);
}

.hero-card-tag {
  position: absolute;
  bottom: 1.25rem;
  left: 1.25rem;
  right: 1.25rem;
  background: rgba(18, 11, 7, 0.88);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(226, 161, 86, 0.3);
  padding: 0.85rem 1.2rem;
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
}

.tag-title {
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--text-white);
}

.tag-sub {
  font-size: 0.78rem;
  color: var(--accent-gold);
}

/* ========================================================
   3. ABOUT SECTION
   ======================================================== */
.about-section {
  padding: 5.5rem 0;
  background-color: var(--bg-surface);
  border-top: 1px solid var(--border-subtle);
  border-bottom: 1px solid var(--border-subtle);
}

.about-grid {
  display: grid;
  grid-template-columns: 0.95fr 1.05fr;
  align-items: center;
  gap: 3.5rem;
}

.about-image-wrap {
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  border: 1px solid var(--border-subtle);
  box-shadow: var(--shadow-card);
}

.about-img {
  width: 100%;
  aspect-ratio: 4/3;
  object-fit: cover;
}

.about-experience-badge {
  position: absolute;
  bottom: 1.5rem;
  right: 1.5rem;
  background: var(--bg-card);
  border: 1px solid var(--border-accent);
  padding: 0.85rem 1.25rem;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.exp-number {
  font-size: 1.15rem;
  font-weight: 800;
  color: var(--accent-gold);
}

.exp-label {
  font-size: 0.72rem;
  color: var(--text-muted);
  text-transform: uppercase;
}

.about-paragraph {
  font-size: 1rem;
  color: var(--text-body);
  line-height: 1.75;
  margin-bottom: 1.25rem;
}

.about-features-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
  margin-top: 2rem;
  padding-top: 1.75rem;
  border-top: 1px solid var(--border-subtle);
}

.about-feat-item {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
}

.feat-icon {
  font-size: 1.6rem;
  line-height: 1;
}

.about-feat-item h4 {
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--text-white);
  margin-bottom: 0.25rem;
}

.about-feat-item p {
  font-size: 0.82rem;
  color: var(--text-muted);
  line-height: 1.5;
}

/* ========================================================
   4. MENU SECTION
   ======================================================== */
.menu-section {
  padding: 5.5rem 0;
  position: relative;
}

.menu-filter-bar {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 0.65rem;
  margin-bottom: 3rem;
  flex-wrap: wrap;
}

.filter-btn {
  font-size: 0.88rem;
  font-weight: 700;
  padding: 0.55rem 1.4rem;
  border-radius: var(--radius-full);
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  color: var(--text-muted);
  cursor: pointer;
  transition: var(--transition);
}

.filter-btn:hover {
  border-color: var(--accent-gold);
  color: var(--text-white);
}

.filter-btn.active {
  background: var(--accent-gold);
  border-color: var(--accent-gold);
  color: #120b07;
  box-shadow: 0 4px 14px rgba(226, 161, 86, 0.35);
}

/* Menu Grid */
.menu-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
  gap: 2rem;
}

.menu-card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow-sm);
  transition: var(--transition);
}

.menu-card:hover {
  transform: translateY(-5px);
  border-color: var(--border-accent);
  box-shadow: var(--shadow-hover);
}

.menu-card-img-box {
  position: relative;
  width: 100%;
  aspect-ratio: 16/10;
  overflow: hidden;
  background-color: #160e09;
}

.menu-card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.menu-card:hover .menu-card-img {
  transform: scale(1.05);
}

.menu-card-badge {
  position: absolute;
  top: 0.85rem;
  left: 0.85rem;
  background: rgba(16, 10, 7, 0.85);
  backdrop-filter: blur(6px);
  border: 1px solid rgba(226, 161, 86, 0.3);
  color: var(--accent-gold);
  font-size: 0.72rem;
  font-weight: 700;
  padding: 0.25rem 0.65rem;
  border-radius: var(--radius-full);
}

.menu-card-badge.bestseller {
  background: rgba(226, 161, 86, 0.9);
  color: #120b07;
}

.menu-card-body {
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.menu-card-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 0.75rem;
  margin-bottom: 0.65rem;
}

.menu-card-title {
  font-size: 1.18rem;
  font-weight: 700;
  color: var(--text-white);
  line-height: 1.3;
}

.menu-card-price {
  font-size: 1.1rem;
  font-weight: 800;
  color: var(--accent-gold);
  white-space: nowrap;
}

.menu-card-desc {
  font-size: 0.88rem;
  color: var(--text-muted);
  line-height: 1.6;
  margin-bottom: 1.4rem;
  flex: 1;
}

.menu-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 1rem;
  border-top: 1px solid rgba(226, 161, 86, 0.1);
}

.menu-card-category-tag {
  font-size: 0.75rem;
  color: var(--text-dim);
  font-weight: 600;
  text-transform: uppercase;
}

.btn-order-item {
  background: rgba(226, 161, 86, 0.12);
  color: var(--accent-gold);
  border: 1px solid var(--border-accent);
  padding: 0.45rem 1.15rem;
  border-radius: var(--radius-sm);
  font-size: 0.85rem;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  cursor: pointer;
  transition: var(--transition);
}

.btn-order-item:hover {
  background: var(--accent-gold);
  color: #120b07;
  transform: translateY(-2px);
  box-shadow: 0 4px 14px rgba(226, 161, 86, 0.35);
}

/* ========================================================
   5. FEATURES SECTION
   ======================================================== */
.features-section {
  padding: 5.5rem 0;
  background-color: var(--bg-surface);
  border-top: 1px solid var(--border-subtle);
  border-bottom: 1px solid var(--border-subtle);
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
}

.feature-box {
  background-color: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 2.25rem 1.75rem;
  transition: var(--transition);
}

.feature-box:hover {
  border-color: var(--border-accent);
  transform: translateY(-4px);
  box-shadow: var(--shadow-hover);
}

.feature-icon-wrap {
  font-size: 2.2rem;
  margin-bottom: 1.25rem;
}

.feature-box h3 {
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--text-white);
  margin-bottom: 0.75rem;
}

.feature-box p {
  font-size: 0.92rem;
  color: var(--text-muted);
  line-height: 1.65;
}

/* ========================================================
   6. GALLERY SECTION
   ======================================================== */
.gallery-section {
  padding: 5.5rem 0;
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.75rem;
}

.gallery-item {
  position: relative;
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 1px solid var(--border-subtle);
  background: var(--bg-card);
  aspect-ratio: 4/3;
  box-shadow: var(--shadow-sm);
}

.gallery-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.gallery-item:hover .gallery-img {
  transform: scale(1.06);
}

.gallery-caption {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, rgba(16, 10, 7, 0.9) 0%, transparent 100%);
  color: var(--text-white);
  font-size: 0.88rem;
  font-weight: 600;
  padding: 1.5rem 1.2rem 1rem;
  transform: translateY(4px);
  transition: var(--transition);
}

/* ========================================================
   7. CONTACT SECTION
   ======================================================== */
.contact-section {
  padding: 5.5rem 0;
  background-color: var(--bg-surface);
  border-top: 1px solid var(--border-subtle);
}

.contact-card-box {
  background: var(--bg-card);
  border: 1px solid var(--border-accent);
  border-radius: var(--radius-lg);
  padding: 3.5rem 3rem;
  box-shadow: var(--shadow-card);
  max-width: 900px;
  margin: 0 auto;
}

.contact-heading {
  font-size: clamp(1.8rem, 3.2vw, 2.3rem);
  font-weight: 800;
  color: var(--text-white);
  line-height: 1.25;
  margin-bottom: 1rem;
}

.contact-desc {
  font-size: 1rem;
  color: var(--text-body);
  line-height: 1.7;
  margin-bottom: 2.25rem;
  max-width: 720px;
}

.contact-details-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
  margin-bottom: 2.5rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid var(--border-subtle);
}

.contact-item {
  display: flex;
  align-items: flex-start;
  gap: 0.85rem;
}

.contact-item-icon {
  font-size: 1.4rem;
  line-height: 1;
}

.contact-item strong {
  display: block;
  font-size: 0.95rem;
  color: var(--text-white);
  margin-bottom: 0.2rem;
}

.contact-item p {
  font-size: 0.88rem;
  color: var(--text-muted);
}

.contact-item a {
  color: var(--accent-gold);
  font-weight: 700;
}

.contact-item a:hover {
  text-decoration: underline;
}

.contact-actions {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}

/* ========================================================
   8. FOOTER
   ======================================================== */
.footer {
  padding: 3.5rem 0 2.5rem;
  background-color: #0b0705;
  border-top: 1px solid var(--border-subtle);
  color: var(--text-muted);
}

.footer-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 2rem;
  border-bottom: 1px solid rgba(226, 161, 86, 0.1);
  margin-bottom: 2rem;
  flex-wrap: wrap;
  gap: 1.5rem;
}

.footer-brand .brand-name {
  font-size: 1.25rem;
  font-weight: 800;
  color: var(--text-white);
  display: inline-block;
  margin-bottom: 0.35rem;
}

.footer-tagline {
  font-size: 0.85rem;
  color: var(--text-dim);
}

.footer-nav {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  flex-wrap: wrap;
}

.footer-nav a {
  font-size: 0.9rem;
  color: var(--text-body);
}

.footer-nav a:hover {
  color: var(--accent-gold);
}

.footer-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.85rem;
  flex-wrap: wrap;
  gap: 1rem;
}

.back-link {
  color: var(--accent-gold);
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
}

.back-link:hover {
  text-decoration: underline;
}

/* ========================================================
   9. INTERACTIVE ORDER MODAL PANEL
   ======================================================== */
.order-modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(10, 6, 4, 0.82);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.25rem;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.25s ease, visibility 0.25s ease;
}

.order-modal-backdrop:not([hidden]) {
  opacity: 1;
  visibility: visible;
}

.order-modal-card {
  background: var(--bg-surface);
  border: 1px solid var(--border-accent);
  border-radius: var(--radius-lg);
  max-width: 480px;
  width: 100%;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transform: scale(0.94);
  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.order-modal-backdrop:not([hidden]) .order-modal-card {
  transform: scale(1);
}

.modal-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.25rem 1.5rem;
  background: #140d09;
  border-bottom: 1px solid var(--border-subtle);
}

.modal-card-badge {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent-gold);
}

.modal-close-btn {
  color: var(--text-muted);
  padding: 0.35rem;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-close-btn:hover {
  color: var(--text-white);
  background: rgba(255, 255, 255, 0.06);
}

.modal-card-body {
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  max-height: 70vh;
  overflow-y: auto;
}

/* Product Summary in Modal */
.modal-product-summary {
  display: flex;
  align-items: center;
  gap: 1.15rem;
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  padding: 1rem;
  border-radius: var(--radius-md);
}

.modal-product-img {
  width: 76px;
  height: 76px;
  border-radius: var(--radius-sm);
  object-fit: cover;
  flex-shrink: 0;
}

.modal-product-title {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--text-white);
  margin-bottom: 0.15rem;
}

.modal-unit-price {
  font-size: 0.95rem;
  font-weight: 800;
  color: var(--accent-gold);
  display: inline-block;
  margin-bottom: 0.25rem;
}

.modal-product-desc {
  font-size: 0.8rem;
  color: var(--text-muted);
  line-height: 1.45;
}

/* Form Groups */
.modal-form-group {
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
}

.modal-label {
  font-size: 0.84rem;
  font-weight: 700;
  color: var(--text-white);
}

.quantity-stepper {
  display: inline-flex;
  align-items: center;
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  width: fit-content;
  overflow: hidden;
}

.stepper-btn {
  width: 44px;
  height: 42px;
  font-size: 1.35rem;
  font-weight: 700;
  color: var(--accent-gold);
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(226, 161, 86, 0.08);
}

.stepper-btn:hover {
  background: var(--accent-gold);
  color: #120b07;
}

.stepper-btn:disabled {
  opacity: 0.35;
  cursor: not-allowed;
}

.quantity-input {
  width: 58px;
  height: 42px;
  border: none;
  background: transparent;
  color: var(--text-white);
  font-family: inherit;
  font-size: 1.1rem;
  font-weight: 800;
  text-align: center;
  outline: none;
}

.modal-input {
  width: 100%;
  padding: 0.75rem 1rem;
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  color: var(--text-white);
  font-family: inherit;
  font-size: 0.9rem;
  outline: none;
  transition: var(--transition);
}

.modal-input:focus {
  border-color: var(--accent-gold);
  box-shadow: 0 0 0 3px rgba(226, 161, 86, 0.15);
}

/* Subtotal Calculation Box */
.modal-subtotal-box {
  background: rgba(226, 161, 86, 0.08);
  border: 1px solid var(--border-accent);
  padding: 1.15rem 1.25rem;
  border-radius: var(--radius-md);
}

.subtotal-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.35rem;
}

.subtotal-label {
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--text-white);
}

.subtotal-val {
  font-size: 1.35rem;
  font-weight: 800;
  color: var(--accent-gold);
}

.subtotal-hint {
  font-size: 0.78rem;
  color: var(--text-muted);
}

/* Transparency Notice */
.modal-demo-notice {
  display: flex;
  align-items: flex-start;
  gap: 0.6rem;
  font-size: 0.78rem;
  color: var(--text-muted);
  line-height: 1.45;
  background: rgba(255, 255, 255, 0.03);
  padding: 0.75rem;
  border-radius: var(--radius-sm);
  border: 1px solid rgba(255, 255, 255, 0.05);
}

.modal-card-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 0.75rem;
  padding: 1.25rem 1.5rem;
  background: #140d09;
  border-top: 1px solid var(--border-subtle);
}

/* ========================================================
   10. TOAST NOTIFICATIONS
   ======================================================== */
.toast-hub {
  position: fixed;
  bottom: 2rem;
  left: 50%;
  transform: translateX(-50%);
  z-index: 300;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  pointer-events: none;
}

.toast-message {
  background: #1b120c;
  border: 1px solid var(--accent-gold);
  color: var(--text-white);
  padding: 0.75rem 1.4rem;
  border-radius: var(--radius-full);
  font-size: 0.88rem;
  font-weight: 600;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  gap: 0.65rem;
  max-width: min(90vw, 480px);
  animation: toast-in 0.3s ease, toast-out 0.3s ease 2.7s forwards;
}

@keyframes toast-in {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes toast-out {
  from { opacity: 1; transform: translateY(0); }
  to { opacity: 0; transform: translateY(-10px); }
}

/* ========================================================
   11. RESPONSIVE MEDIA QUERIES
   ======================================================== */
@media (max-width: 992px) {
  .hero-container {
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  .hero-visual {
    order: -1;
  }

  .hero-image-card {
    max-width: 100%;
  }

  .about-grid {
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .features-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .gallery-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 768px) {
  .header {
    height: 66px;
    --header-height: 66px;
  }

  .nav-toggle {
    display: flex;
  }

  .nav-links {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background-color: #150e09;
    border-bottom: 1px solid var(--border-accent);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.7);
    flex-direction: column;
    padding: 1.5rem 1.75rem;
    gap: 1.15rem;
    z-index: 105;
  }

  .nav-links.is-active {
    display: flex;
  }

  .btn-order-nav {
    width: 100%;
    text-align: center;
    padding: 0.75rem;
  }

  .features-grid {
    grid-template-columns: 1fr;
  }

  .gallery-grid {
    grid-template-columns: 1fr;
  }

  .contact-details-list {
    grid-template-columns: 1fr;
  }

  .contact-card-box {
    padding: 2.5rem 1.75rem;
  }
}

@media (max-width: 480px) {
  .hero-section {
    padding: 3rem 0 4rem;
  }

  .hero-title {
    font-size: 2.1rem;
  }

  .hero-actions {
    flex-direction: column;
    width: 100%;
  }

  .hero-actions .btn {
    width: 100%;
  }

  .hero-stats-strip {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .stat-separator {
    display: none;
  }

  .about-features-row {
    grid-template-columns: 1fr;
  }

  .menu-grid {
    grid-template-columns: 1fr;
  }

  .modal-card-footer {
    flex-direction: column-reverse;
  }

  .modal-card-footer .btn {
    width: 100%;
    justify-content: center;
  }

  .contact-actions {
    flex-direction: column;
    width: 100%;
  }

  .contact-actions .btn {
    width: 100%;
  }
}
